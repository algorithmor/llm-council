# Copy to .env and fill in (all optional — you can use the Setup page instead).
# The API key is a YouTube Data API v3 key from https://console.cloud.google.com/apis/credentials
DAILYBEE_YOUTUBE_API_KEY=
# Your channel: @handle, UC... channel id, or channel URL. Subscriptions must be public.
DAILYBEE_YOUTUBE_CHANNEL=
# Optional login for the web UI, username:password
DAILYBEE_AUTH=
# Your time zone, e.g. Europe/London or America/New_York
TZ=UTC
